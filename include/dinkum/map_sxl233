// <map> as seen through the Dinkum C++ Library 2.33. RECONSTRUCTION.
// The stock VC6 <map> over the 2.33 <xtree>, changed to what Default.dll proves:
//  - the default allocator is allocator<value_type> (the standard's), not allocator<_Ty>: _Insert's length
//    check is (size_t)-1 / sizeof (pair<const K, T>) (0x12131: 0xccccccc for a 0x14-byte value)
//  - _Multi is the tree's template argument (no bool member)
//  - ctors are an overload set (map(), map(pred), map(pred, alloc)) like sxlrt233's basic_string, not default
//    arguments
#ifndef _MAP_
#define _MAP_
#include <functional>
#include <xtree>

#ifdef  _MSC_VER
#pragma pack(push,8)
#endif  /* _MSC_VER */

_STD_BEGIN
		// TEMPLATE CLASS map
		// derived form (map/multimap derive from _Tree, as the WON objects inline _Tree::insert at depth 1; the key
		// extractor lives in a holder because a class cannot name its own nested type in its base clause)
template<class _K, class _Ty, class _Pr, class _A>
	struct _Mapk {
	struct _Kfn : public unary_function<pair<const _K, _Ty>, _K> {
		const _K& operator()(const pair<const _K, _Ty>& _X) const
		{return (_X.first); }
		};
	};
template<class _K, class _Ty, class _Pr = less<_K>,
	class _A = allocator<pair<const _K, _Ty> > >
	class map : public _Tree<_K, pair<const _K, _Ty>,
		_Mapk<_K, _Ty, _Pr, _A>::_Kfn, _Pr, _A, false> {
public:
	typedef map<_K, _Ty, _Pr, _A> _Myt;
	typedef pair<const _K, _Ty> value_type;
	class value_compare
		: public binary_function<value_type, value_type, bool> {
		friend class map<_K, _Ty, _Pr, _A>;
	public:
		bool operator()(const value_type& _X,
			const value_type& _Y) const
			{return (comp(_X.first, _Y.first)); }
	_PROTECTED:
		value_compare(_Pr _Pred)
			: comp(_Pred) {}
		_Pr comp;
		};
	typedef _K key_type;
	typedef _Ty referent_type;
	typedef _Pr key_compare;
	typedef _A allocator_type;
	typedef _Tree<_K, value_type, _Mapk<_K, _Ty, _Pr, _A>::_Kfn, _Pr, _A, false> _Imp;
	typedef _Imp::size_type size_type;
	typedef _Imp::difference_type difference_type;
	typedef _Imp::reference reference;
	typedef _Imp::const_reference const_reference;
	typedef _Imp::iterator iterator;
	typedef _Imp::const_iterator const_iterator;
	typedef _Imp::reverse_iterator reverse_iterator;
	typedef _Imp::const_reverse_iterator const_reverse_iterator;
	typedef pair<iterator, iterator> _Pairii;
	typedef pair<const_iterator, const_iterator> _Paircc;
	typedef pair<iterator, bool> _Pairib;
	map()
		: _Imp(_Pr(), _A()) {}
	explicit map(const _Pr& _Pred)
		: _Imp(_Pred, _A()) {}
	map(const _Pr& _Pred, const _A& _Al)
		: _Imp(_Pred, _Al) {}
	typedef const value_type *_It;
	map(_It _F, _It _L, const _Pr& _Pred = _Pr(),
		const _A& _Al = _A())
		: _Imp(_Pred, _Al)
		{for (; _F != _L; ++_F)
			insert(*_F); }
	_Ty& operator[](const key_type& _Kv)	// proven: insert direct, no _Pairib copy (LLE 0x1de4)
		{iterator _P = insert(value_type(_Kv, _Ty())).first;
		return ((*_P).second); }
	value_compare value_comp() const
		{return (value_compare(key_comp())); }
	};
		// map TEMPLATE OPERATORS
template<class _K, class _Ty, class _Pr, class _A> inline
	bool operator==(const map<_K, _Ty, _Pr, _A>& _X,
		const map<_K, _Ty, _Pr, _A>& _Y)
	{return (_X.size() == _Y.size()
		&& equal(_X.begin(), _X.end(), _Y.begin())); }
template<class _K, class _Ty, class _Pr, class _A> inline
	bool operator!=(const map<_K, _Ty, _Pr, _A>& _X,
		const map<_K, _Ty, _Pr, _A>& _Y)
	{return (!(_X == _Y)); }
template<class _K, class _Ty, class _Pr, class _A> inline
	bool operator<(const map<_K, _Ty, _Pr, _A>& _X,
		const map<_K, _Ty, _Pr, _A>& _Y)
	{return (lexicographical_compare(_X.begin(), _X.end(),
		_Y.begin(), _Y.end())); }
template<class _K, class _Ty, class _Pr, class _A> inline
	bool operator>(const map<_K, _Ty, _Pr, _A>& _X,
		const map<_K, _Ty, _Pr, _A>& _Y)
	{return (_Y < _X); }
template<class _K, class _Ty, class _Pr, class _A> inline
	bool operator<=(const map<_K, _Ty, _Pr, _A>& _X,
		const map<_K, _Ty, _Pr, _A>& _Y)
	{return (!(_Y < _X)); }
template<class _K, class _Ty, class _Pr, class _A> inline
	bool operator>=(const map<_K, _Ty, _Pr, _A>& _X,
		const map<_K, _Ty, _Pr, _A>& _Y)
	{return (!(_X < _Y)); }
		// TEMPLATE CLASS multimap
		// derived form (map/multimap derive from _Tree, as the WON objects inline _Tree::insert at depth 1; the key
		// extractor lives in a holder because a class cannot name its own nested type in its base clause)
template<class _K, class _Ty, class _Pr, class _A>
	struct _Mmapk {
	struct _Kfn : public unary_function<pair<const _K, _Ty>, _K> {
		const _K& operator()(const pair<const _K, _Ty>& _X) const
		{return (_X.first); }
		};
	};
template<class _K, class _Ty, class _Pr = less<_K>,
	class _A = allocator<pair<const _K, _Ty> > >
	class multimap : public _Tree<_K, pair<const _K, _Ty>,
		_Mmapk<_K, _Ty, _Pr, _A>::_Kfn, _Pr, _A, true> {
public:
	typedef multimap<_K, _Ty, _Pr, _A> _Myt;
	typedef pair<const _K, _Ty> value_type;
	class value_compare
		: public binary_function<value_type, value_type, bool> {
		friend class multimap<_K, _Ty, _Pr, _A>;
	public:
		bool operator()(const value_type& _X,
			const value_type& _Y) const
			{return (comp(_X.first, _Y.first)); }
	_PROTECTED:
		value_compare(_Pr _Pred)
			: comp(_Pred) {}
		_Pr comp;
		};
	typedef _K key_type;
	typedef _Ty referent_type;
	typedef _Pr key_compare;
	typedef _A allocator_type;
	typedef _Tree<_K, value_type, _Mmapk<_K, _Ty, _Pr, _A>::_Kfn, _Pr, _A, true> _Imp;
	typedef _Imp::size_type size_type;
	typedef _Imp::difference_type difference_type;
	typedef _Imp::reference reference;
	typedef _Imp::const_reference const_reference;
	typedef _Imp::iterator iterator;
	typedef _Imp::const_iterator const_iterator;
	typedef _Imp::reverse_iterator reverse_iterator;
	typedef _Imp::const_reverse_iterator const_reverse_iterator;
	typedef pair<iterator, iterator> _Pairii;
	typedef pair<const_iterator, const_iterator> _Paircc;
	explicit multimap(const _Pr& _Pred = _Pr(),
		const _A& _Al = _A())
		: _Imp(_Pred, _Al) {}
	typedef const value_type *_It;
	multimap(_It _F, _It _L, const _Pr& _Pred = _Pr(),
			const _A& _Al = _A())
		: _Imp(_Pred, _Al)
		{for (; _F != _L; ++_F)
			_Imp::insert(*_F); }
	iterator insert(const value_type& _X)
		{return (_Imp::insert(_X).first); }
	iterator insert(iterator _P, const value_type& _X)
		{return (_Imp::insert(_P, _X)); }
	void insert(_It _F, _It _L)
		{for (; _F != _L; ++_F)
			_Imp::insert(*_F); }
	value_compare value_comp() const
		{return (value_compare(key_comp())); }
	};
		// multimap TEMPLATE OPERATORS
template<class _K, class _Ty, class _Pr, class _A> inline
	bool operator==(const multimap<_K, _Ty, _Pr, _A>& _X,
		const multimap<_K, _Ty, _Pr, _A>& _Y)
	{return (_X.size() == _Y.size()
		&& equal(_X.begin(), _X.end(), _Y.begin())); }
template<class _K, class _Ty, class _Pr, class _A> inline
	bool operator!=(const multimap<_K, _Ty, _Pr, _A>& _X,
		const multimap<_K, _Ty, _Pr, _A>& _Y)
	{return (!(_X == _Y)); }
template<class _K, class _Ty, class _Pr, class _A> inline
	bool operator<(const multimap<_K, _Ty, _Pr, _A>& _X,
		const multimap<_K, _Ty, _Pr, _A>& _Y)
	{return (lexicographical_compare(_X.begin(), _X.end(),
		_Y.begin(), _Y.end())); }
template<class _K, class _Ty, class _Pr, class _A> inline
	bool operator>(const multimap<_K, _Ty, _Pr, _A>& _X,
		const multimap<_K, _Ty, _Pr, _A>& _Y)
	{return (_Y < _X); }
template<class _K, class _Ty, class _Pr, class _A> inline
	bool operator<=(const multimap<_K, _Ty, _Pr, _A>& _X,
		const multimap<_K, _Ty, _Pr, _A>& _Y)
	{return (!(_Y < _X)); }
template<class _K, class _Ty, class _Pr, class _A> inline
	bool operator>=(const multimap<_K, _Ty, _Pr, _A>& _X,
		const multimap<_K, _Ty, _Pr, _A>& _Y)
	{return (!(_X < _Y)); }
_STD_END
#ifdef  _MSC_VER
#pragma pack(pop)
#endif  /* _MSC_VER */

#endif /* _MAP_ */

