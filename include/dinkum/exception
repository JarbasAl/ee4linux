// <exception> as seen through the Dinkum C++ Library 2.33. RECONSTRUCTION.
// Dinkum's own std::exception replaces Microsoft's ::exception (the import is ?_Throw@std@@YAXABVexception@1@@Z).
// sxlrt233.dll exports only _Raise_handler, _Throw and uncaught_exception; everything else is inline here.
// Proven by TCP Protocol.dll: exception = { vfptr, const char *_Ptr } (what() 0x40e1 = mov eax,[ecx+4]),
// vtable { scalar deleting dtor 0x4109, what 0x40e1, _Doraise 0x4108 (empty) }, _Raise 0x40e5.
#ifndef _EXCEPTION_
#define _EXCEPTION_
#include <xstddef>
#include <eh.h>

#ifdef  _MSC_VER
#pragma pack(push,8)
#endif  /* _MSC_VER */
#ifndef _CRTIMP2
 #ifdef _DLL
  #define _CRTIMP2	__declspec(dllimport)
 #else
  #define _CRTIMP2
 #endif
#endif
_STD_BEGIN
class exception;
typedef void (__cdecl *_Prhand)(const exception&);
extern _CRTIMP2 _Prhand _Raise_handler;
_CRTIMP2 void __cdecl _Throw(const exception&);

		// CLASS exception
class exception {
public:
	static _Prhand _Set_raise_handler(_Prhand _Pnew)
		{const _Prhand _Pold = _Raise_handler;
		_Raise_handler = _Pnew;
		return (_Pold); }
	explicit exception(const char *_S = "unknown") _THROW0()
		: _Ptr(_S) {}
	exception(const exception& _X) _THROW0()
		: _Ptr(_X._Ptr) {}
	exception& operator=(const exception& _X) _THROW0()
		{_Ptr = _X._Ptr;
		return (*this); }
	virtual ~exception()
		{}
	virtual const char *what() const _THROW0()
		{return (_Ptr); }
	void _Raise() const
		{if (_Raise_handler != 0)
			(*_Raise_handler)(*this);
		_Doraise();
		_RAISE(*this); }
protected:
	virtual void _Doraise() const
		{}
protected:
	const char *_Ptr;
	};
		// CLASS bad_exception
class bad_exception : public exception {
public:
	bad_exception(const char *_S = "bad exception") _THROW0()
		: exception(_S) {}
	virtual ~bad_exception() _THROW0()
		{}
protected:
	virtual void _Doraise() const
		{_RAISE(*this); }
	};
_CRTIMP2 bool __cdecl uncaught_exception();
_STD_END
#ifdef  _MSC_VER
#pragma pack(pop)
#endif  /* _MSC_VER */
#endif /* _EXCEPTION_ */
