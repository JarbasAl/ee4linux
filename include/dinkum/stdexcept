// <stdexcept> as seen through the Dinkum C++ Library 2.33. RECONSTRUCTION.
// The stock VC6 header (already Dinkum-shaped: exception(""), string _Str, _Doraise) without _CRTIMP:
// sxlrt233.dll exports none of these classes, so the TU emits them (TCP: logic_error ctor 0x4126,
// scalar deleting dtor 0x4183, what 0x416d, _Doraise 0x417a; length_error folded onto them by ICF).
#ifndef _STDEXCEPT_
#define _STDEXCEPT_
#include <exception>
#include <xstring>

#ifdef  _MSC_VER
#pragma pack(push,8)
#endif  /* _MSC_VER */
_STD_BEGIN
		// CLASS logic_error
class logic_error : public exception {
public:
	explicit logic_error(const string& _S)
		: exception(""), _Str(_S) {}
	virtual ~logic_error()
		{}
	virtual const char *what() const
		{return (_Str.c_str()); }
protected:
	virtual void _Doraise() const
		{_RAISE(*this); }
private:
	string _Str;
	};
		// CLASS domain_error
class domain_error : public logic_error {
public:
	explicit domain_error(const string& _S)
		: logic_error(_S) {}
	virtual ~domain_error()
